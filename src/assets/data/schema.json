{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    { "$ref": "#/definitions/clientProjectList" },
    { "$ref": "#/definitions/personalProjectList" }
  ],
  "definitions": {
    "clientProject": {
      "type": "object",
      "required": ["name", "desc"],
      "properties": {
        "name": { "type": "string" },
        "desc": { "type": "string" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "clientProjectList": {
      "type": "array",
      "items": { "$ref": "#/definitions/clientProject" }
    },
    "personalProject": {
      "type": "object",
      "required": ["name", "desc", "repo"],
      "properties": {
        "name": { "type": "string" },
        "desc": { "type": "string" },
        "repo": { "type": "string", "format": "uri" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "personalProjectList": {
      "type": "array",
      "items": { "$ref": "#/definitions/personalProject" }
    }
  }
}
